**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# ──────────────────────────────────────────────────────────────────────
# Mobile (Capacitor iOS + Android)
# ──────────────────────────────────────────────────────────────────────
# Android — output di build, niente di tutto questo serve in repo
frontend/android/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/release.keystore
frontend/android/app/debug.keystore
frontend/android/key.properties
frontend/android/app/release/
*.apk
*.aab

# iOS — Pods e build artifact ricostruibili
frontend/ios/App/Pods/
frontend/ios/App/Podfile.lock
frontend/ios/App/build/
frontend/ios/DerivedData/
frontend/ios/App/App.xcworkspace/xcuserdata/
frontend/ios/App/App.xcodeproj/xcuserdata/
frontend/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
*.ipa
*.dSYM.zip
*.dSYM
.xcode.env.local

# Capacitor — bundle generato da `cap copy` (duplicato di frontend/build)
frontend/android/app/src/main/assets/public/
frontend/ios/App/App/public/

# Generated CocoaPods workspace (rigenerato da pod install)
frontend/ios/App/App.xcworkspace/contents.xcworkspacedata

# Keystore Java + signing config (devono restare fuori repo)
*.keystore
*.jks
keystore-properties.json

# Store assets generated by scripts (rigenerabili)
frontend/store-assets/
